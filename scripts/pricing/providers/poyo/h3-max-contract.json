{
	"input_schema": {
		"type": "object",
		"allOf": [
			{
				"not": {
					"not": {
						"not": {
							"required": ["aspect_ratio"]
						},
						"properties": {
							"reference_audio_urls": {
								"maxItems": 0
							},
							"reference_image_urls": {
								"maxItems": 0
							},
							"reference_video_urls": {
								"maxItems": 0
							}
						}
					},
					"required": ["image_urls"],
					"properties": {
						"image_urls": {
							"minItems": 1
						}
					}
				}
			},
			{
				"not": {
					"required": ["aspect_ratio"],
					"properties": {
						"aspect_ratio": {
							"enum": ["adaptive"]
						},
						"reference_audio_urls": {
							"maxItems": 0
						},
						"reference_image_urls": {
							"maxItems": 0
						},
						"reference_video_urls": {
							"maxItems": 0
						}
					}
				}
			},
			{
				"not": {
					"not": {
						"required": ["reference_image_urls"],
						"properties": {
							"reference_image_urls": {
								"minItems": 1
							}
						}
					},
					"required": ["reference_video_urls"],
					"properties": {
						"reference_video_urls": {
							"minItems": 1
						}
					}
				}
			},
			{
				"not": {
					"not": {
						"required": ["reference_image_urls"],
						"properties": {
							"reference_image_urls": {
								"minItems": 1
							}
						}
					},
					"required": ["reference_audio_urls"],
					"properties": {
						"reference_audio_urls": {
							"minItems": 1
						}
					}
				}
			}
		],
		"required": ["prompt"],
		"properties": {
			"prompt": {
				"type": "string",
				"pattern": "\\S",
				"maxLength": 50000,
				"minLength": 1
			},
			"duration": {
				"type": "integer",
				"default": 5,
				"maximum": 15,
				"minimum": 5
			},
			"image_urls": {
				"type": "array",
				"items": {
					"type": "string",
					"format": "uri",
					"pattern": "^https?://"
				},
				"maxItems": 2
			},
			"resolution": {
				"enum": ["480p", "768p", "1080p"],
				"type": "string",
				"default": "768p"
			},
			"aspect_ratio": {
				"enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"],
				"type": "string"
			},
			"reference_audio_urls": {
				"type": "array",
				"items": {
					"type": "string",
					"format": "uri",
					"pattern": "^https?://"
				},
				"maxItems": 3
			},
			"reference_image_urls": {
				"type": "array",
				"items": {
					"type": "string",
					"format": "uri",
					"pattern": "^https?://"
				},
				"maxItems": 9
			},
			"reference_video_urls": {
				"type": "array",
				"items": {
					"type": "string",
					"format": "uri",
					"pattern": "^https?://"
				},
				"maxItems": 3
			},
			"enable_safety_checker": {
				"type": "boolean",
				"default": true
			}
		},
		"additionalProperties": false
	},
	"billingRule": {
		"type": "parameterized",
		"unit": "request",
		"credits": null,
		"formula": "duration * resolution_credits_per_second[resolution] + max(0, reference_tokens - free_reference_tokens) * reference_credits_per_1000_tokens / 1000",
		"parameters": {
			"duration": "Requested output seconds; defaults to 5",
			"resolution": "Defaults to 768p",
			"reference_tokens": "Server-computed image + video + audio tokens; zero outside reference mode; never client supplied"
		},
		"input_credits": null,
		"output_credits": null,
		"free_reference_tokens": 4096,
		"reference_credits_per_1000_tokens": 4
	}
}
