{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css,svelte,html}",
			"!!.agents/skills",
			"!!.claude",
			"!!.codex",
			"!!.impeccable",
			"!!skills-lock.json",
			"!!scripts/media-catalog/sources/poyo-*.json",
			"!!src/lib/shared/media-catalog/poyo-rows.json",
			"!!src/lib/shared/media-catalog/poyo-picker.json",
			"!!src/lib/shared/media-catalog/poyo-formats.json",
			"!!src/lib/shared/media-catalog/poyo-queue.json",
			"!!src/lib/server/providers/poyo/queue-schemas.json"
		]
	},
	"formatter": { "enabled": true, "lineWidth": 100 },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"overrides": [
		{
			"includes": ["tests/browser/**/*.spec.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": {
										"importNames": ["test", "default"],
										"message": "Import test from ./studio-test so CSP violations fail the journey."
									}
								}
							}
						}
					}
				}
			}
		}
	],
	"assist": { "enabled": true, "actions": { "source": { "preset": "recommended" } } },
	"html": { "experimentalFullSupportEnabled": true, "formatter": { "enabled": true } }
}
